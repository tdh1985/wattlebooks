<Window x:Class="Wattlebooks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:host="clr-namespace:Wattlebooks.App.Host"
        xmlns:ui="clr-namespace:Wattlebooks.Ui;assembly=Wattlebooks.Ui"
        Title="Wattlebooks"
        Width="1520" Height="960" MinWidth="1024" MinHeight="660"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>
    <host:EmbeddedBlazorWebView x:Name="WebView" HostPage="wwwroot\index.html" Services="{DynamicResource services}">
        <host:EmbeddedBlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:Main}" />
        </host:EmbeddedBlazorWebView.RootComponents>
    </host:EmbeddedBlazorWebView>
</Window>
