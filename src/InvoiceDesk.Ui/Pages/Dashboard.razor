@page "/"
@implements IDisposable
@inject DashboardService DashboardStore
@inject ProfileService Profiles
@inject ClientService ClientStore
@inject InvoiceService InvoiceStore
@inject TransactionService Ledger
@inject InsightService Insights
@inject TimeProvider Clock

<div class="page">
    @if (_data is not null && _profile is not null)
    {
        <header class="owed-head">
            <div class="owed-title">
                <p class="owed-date">@Clock.Today().ToString("dddd d MMMM yyyy", CultureInfo.InvariantCulture)</p>
                <h1 tabindex="-1">
                    @if (_data.OutstandingCount > 0)
                    {
                        <span class="owed-lead">Clients owe you</span>
                        <span class="owed-figure num">@Format.Money(_data.OutstandingCents)</span>
                    }
                    else
                    {
                        <span class="owed-lead">@(_invoiceCount == 0 ? "Nothing sent yet" : "Nothing waiting on clients")</span>
                    }
                </h1>
                @if (_data.OverdueCount > 0)
                {
                    <span class="owed-late">@Format.Money(_data.OverdueCents) of it is late</span>
                }
                @if (_data.OtherOutstanding.Count > 0)
                {
                    <span class="small muted">plus @Format.MoneyList(_data.OtherOutstanding) in other currencies</span>
                }
            </div>
            <div class="page-actions">
                <a class="btn" href="money?new=out"><Icon Name="receipt" Size="16" /> Add expense</a>
                <a class="btn btn-primary" href="invoices/new"><Icon Name="plus" Size="16" /> New invoice</a>
            </div>
        </header>

        @if (!SetupDone)
        {
            <section class="checklist" aria-label="Getting started">
                <div class="step @(HasBusiness ? "done" : null)">
                    <span class="step-num">@(HasBusiness ? "✓" : "1")</span>
                    <h3>Add your business details</h3>
                    <p class="soft small">Your name and @Format.Country.TaxNumber.Label go on every invoice. Tax invoices need both.</p>
                    @if (!HasBusiness)
                    {
                        <a class="btn btn-sm" href="settings">Open settings</a>
                    }
                </div>
                <div class="step @(_clientCount > 0 ? "done" : null)">
                    <span class="step-num">@(_clientCount > 0 ? "✓" : "2")</span>
                    <h3>Add a client</h3>
                    <p class="soft small">Who you bill. You can also add one while writing an invoice.</p>
                    @if (_clientCount == 0)
                    {
                        <a class="btn btn-sm" href="clients?new=1">Add a client</a>
                    }
                </div>
                <div class="step @(_invoiceCount > 0 ? "done" : null)">
                    <span class="step-num">@(_invoiceCount > 0 ? "✓" : "3")</span>
                    <h3>Create your first invoice</h3>
                    <p class="soft small">@Format.Country.TaxWord on makes it a tax invoice; off makes it a plain invoice.</p>
                    @if (_invoiceCount == 0)
                    {
                        <a class="btn btn-sm btn-primary" href="invoices/new">New invoice</a>
                    }
                </div>
            </section>
            @if (_clientCount == 0 && _invoiceCount == 0)
            {
                <p class="small soft" style="margin: -16px 0 28px">
                    Already using InvoiceDesk on another PC? <a href="settings#data">Open that data here</a>.
                </p>
            }
        }

        <TicketRail Open="_data.Open" Expected="_expected" Today="Clock.Today()" OnRemind="id => _remindId = id" />

        <div class="dash-grid">
            <section>
                <div class="section-head">
                    <h2>@Clock.Today().ToString("MMMM", CultureInfo.InvariantCulture) so far</h2>
                    <a class="small" href="money">Money in &amp; out</a>
                </div>
                <CashBook Entries="_data.MonthEntries" InCents="_data.ReceivedMonthCents" OutCents="_data.SpentMonthCents" />
            </section>

            <div class="col gap-32">
                <section>
                    <div class="section-head"><h2>The year</h2><span class="soft">Last 12 months</span></div>
                    <BarChart Months="_data.Months" />
                    <dl class="year-figures">
                        <div title="Profit for this @FinancialPeriods.YearNoun(Countries.For(_profile!.Country))">
                            <dt>Profit, @_data.YearLabel<small>Money in less money out, excluding @Format.Country.TaxWord</small></dt>
                            <dd class="num">@Format.Money(_data.ProfitYearCents)</dd>
                        </div>
                        <div>
                            <dt>
                                <a href="reports" title="Open the @Format.Country.ReturnTitle">@Format.Country.TaxName for @_data.PeriodLabel</a>
                                @if (Format.Country.ExpensesCarryTax)
                                {
                                    <small>@(_data.TaxNetPeriodCents >= 0 ? "To set aside" : "Refund due"): collected @Format.Money(_data.TaxCollectedPeriodCents), paid @Format.Money(_data.TaxPaidPeriodCents)</small>
                                }
                                else
                                {
                                    <small>Collected</small>
                                }
                            </dt>
                            <dd class="num @(Format.Country.ExpensesCarryTax && _data.TaxNetPeriodCents > 0 ? "danger-text" : null)">
                                @Format.Money(Format.Country.ExpensesCarryTax ? Math.Abs(_data.TaxNetPeriodCents) : _data.TaxCollectedPeriodCents)
                            </dd>
                        </div>
                    </dl>
                </section>

                <section>
                    <div class="section-head"><h2>Recent activity</h2></div>
                    @if (_data.Recent.Count == 0)
                    {
                        <p class="soft small">Invoices, payments and expenses will be listed here as you add them.</p>
                    }
                    else
                    {
                        <ul class="list-rows">
                            @foreach (var item in _data.Recent.Take(5))
                            {
                                <li>
                                    <a href="@Href(item)">
                                        <span class="list-icon"><Icon Name="@ActivityIcon(item.Kind)" Size="15" /></span>
                                        <span class="list-main">
                                            <span class="list-title">@item.Title</span>
                                            <span class="list-sub">@item.Detail</span>
                                        </span>
                                        <span class="col" style="align-items:flex-end">
                                            <span class="num">@Format.Money(item.AmountCents, item.Currency.Length > 0 ? item.Currency : Format.Country.Currency)</span>
                                            <span class="list-sub">@Format.DateShort(DateOnly.FromDateTime(item.At))</span>
                                        </span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>
        </div>
    }
</div>

<ReminderModal Open="_remindId is not null" InvoiceId="_remindId" OnClose="() => _remindId = null" OnSent="() => _remindId = null" />

@code {
    int? _remindId;
    DashboardData? _data;
    IReadOnlyDictionary<int, DateOnly> _expected = new Dictionary<int, DateOnly>();
    BusinessProfile? _profile;
    int _clientCount;
    int _invoiceCount;

    bool HasBusiness => _profile is not null && _profile.Name.Length > 0;
    bool SetupDone => HasBusiness && _clientCount > 0 && _invoiceCount > 0;

    protected override async Task OnInitializedAsync()
    {
        Profiles.Changed += OnChanged;
        ClientStore.Changed += OnChanged;
        InvoiceStore.Changed += OnChanged;
        Ledger.Changed += OnChanged;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _profile = await Profiles.GetAsync();
        _data = await DashboardStore.GetAsync();
        _expected = (await Insights.GetForecastAsync()).Items.ToDictionary(e => e.Invoice.Id, e => e.ExpectedDate);
        _clientCount = (await ClientStore.ListAsync()).Count;
        _invoiceCount = (await InvoiceStore.ListAsync()).Count;
    }

    static string Href(ActivityItem item) => item.Kind switch
    {
        ActivityKind.Income or ActivityKind.Expense => $"money?open={item.EntityId}",
        _ => $"invoices/{item.EntityId}",
    };

    static string ActivityIcon(ActivityKind kind) => kind switch
    {
        ActivityKind.InvoiceCreated => "invoice",
        ActivityKind.InvoiceSent => "send",
        ActivityKind.PaymentReceived => "in",
        ActivityKind.Income => "in",
        _ => "out",
    };

    void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Profiles.Changed -= OnChanged;
        ClientStore.Changed -= OnChanged;
        InvoiceStore.Changed -= OnChanged;
        Ledger.Changed -= OnChanged;
    }
}
