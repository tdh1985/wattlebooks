@implements IDisposable
@inject ToastService Toasts

<div class="toasts" role="status" aria-live="polite">
    @foreach (var toast in Toasts.Items)
    {
        <div class="toast toast-@toast.Kind.ToString().ToLowerInvariant()" @key="toast.Id">
            <Icon Name="@(toast.Kind == ToastKind.Error ? "alert" : toast.Kind == ToastKind.Info ? "undo" : "check")" Size="16" Class="toast-icon" />
            <span class="toast-msg">@toast.Message</span>
            @foreach (var action in toast.Actions)
            {
                <button type="button" class="toast-action" @onclick="() => RunAsync(toast, action)">@action.Label</button>
            }
            <button type="button" class="toast-close" aria-label="Dismiss" @onclick="() => Toasts.Dismiss(toast.Id)"><Icon Name="x" Size="14" /></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    void OnChanged() => InvokeAsync(StateHasChanged);

    async Task RunAsync(Toast toast, ToastAction action)
    {
        Toasts.Dismiss(toast.Id);
        try { await action.Run(); }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    public void Dispose() => Toasts.Changed -= OnChanged;
}
