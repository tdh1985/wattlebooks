@* no injected services since HtmlRenderer also renders this for pdfs *@
@{
    var rules = Countries.For(Profile.Country);
    var totals = Invoice.Totals();
    var bands = totals.Bands;
    var paid = Invoice.PaidCents;
    var balance = Math.Max(0, totals.TotalCents - paid);
    var status = InvoiceStatusResolver.Resolve(Invoice.Kind, Invoice.Status, totals.TotalCents, paid, Invoice.DueDate, Today);
    var quote = Invoice.Kind == InvoiceKind.Quote;
    var client = Invoice.Client;
    var lines = Invoice.Lines.Where(l => !string.IsNullOrWhiteSpace(l.Description) || l.UnitPriceCents != 0).ToList();
    var hasGstFree = totals.IsTaxInvoice && lines.Any(l => l.TaxCode == TaxCode.Zero);
    var hasBank = Profile.AccountNumber.Length > 0 || Profile.BankCode.Length > 0;
    var showVatColumn = rules.HasReducedRate && totals.IsTaxInvoice;
    var columnCount = showVatColumn ? 5 : 4;
}
<article class="doc doc-@InvoiceTemplates.Normalise(Template ?? Profile.InvoiceTemplate)" style="--doc-accent: @Profile.AccentColour">
    <header class="doc-head">
        <div class="doc-from">
            @if (LogoUrl is not null)
            {
                <img class="doc-logo" src="@LogoUrl" alt="" />
            }
            <div class="doc-from-text">
                <div class="doc-biz">@(Profile.Name.Length > 0 ? Profile.Name : "Your business name")</div>
                @if (rules.TaxNumber.IsValid(Profile.TaxNumber))
                {
                    <div class="doc-small">@rules.TaxNumber.Label @rules.TaxNumber.Display(Profile.TaxNumber)</div>
                }
                @if (Profile.Address.Length > 0)
                {
                    <div class="doc-small doc-pre">@Profile.Address</div>
                }
                @if (Profile.Email.Length > 0)
                {
                    <div class="doc-small">@Profile.Email</div>
                }
                @if (Profile.Phone.Length > 0)
                {
                    <div class="doc-small">@Profile.Phone</div>
                }
                @if (Profile.Website.Length > 0)
                {
                    <div class="doc-small"><a class="doc-link" href="@WebAddress.Href(Profile.Website)">@WebAddress.Display(Profile.Website)</a></div>
                }
            </div>
        </div>
        <div class="doc-title">
            <h1>@Invoice.Heading(Countries.For(Profile.Country))</h1>
            <div class="doc-number">@(Invoice.Number.Length > 0 ? Invoice.Number : NumberPreview)</div>
        </div>
    </header>

    <section class="doc-parties">
        <div>
            <div class="doc-label">@(quote ? "Quote for" : "Bill to")</div>
            @if (client is not null)
            {
                <div class="doc-client">@client.Name</div>
                @if (client.ContactName.Length > 0)
                {
                    <div class="doc-small">Attention: @client.ContactName</div>
                }
                @if (client.Address.Length > 0)
                {
                    <div class="doc-small doc-pre">@client.Address</div>
                }
                @if (InvoiceDefaults.IsOverseas(client, Profile))
                {
                    <div class="doc-small">@WorldCountries.Name(client.Country)</div>
                }
                var clientTaxRule = InvoiceDefaults.TaxNumberRuleFor(client, Profile);
                @if (clientTaxRule is not null && clientTaxRule.IsValid(client.TaxNumber))
                {
                    <div class="doc-small">@clientTaxRule.Label @clientTaxRule.Display(client.TaxNumber)</div>
                }
                else if (clientTaxRule is null && client.TaxNumber.Length > 0)
                {
                    <div class="doc-small">Tax number @client.TaxNumber</div>
                }
                @if (client.Website.Length > 0)
                {
                    <div class="doc-small"><a class="doc-link" href="@WebAddress.Href(client.Website)">@WebAddress.Display(client.Website)</a></div>
                }
                @if (client.InvoiceNote.Length > 0)
                {
                    <div class="doc-client-note doc-pre">@client.InvoiceNote</div>
                }
            }
            else
            {
                <div class="doc-client doc-placeholder">Choose a client</div>
            }
        </div>
        <dl class="doc-dates">
            <dt>Issued</dt>
            <dd>@Format.DateLong(Invoice.IssueDate)</dd>
            <dt>@(quote ? "Valid until" : "Due")</dt>
            <dd>@Format.DateLong(Invoice.DueDate)</dd>
            @if (!quote)
            {
                <dt class="doc-due">Amount due</dt>
                <dd class="doc-due">@Format.Money(balance)</dd>
            }
        </dl>
    </section>

    <table class="doc-lines">
        <thead>
            <tr>
                <th>Description</th>
                <th class="n">Qty</th>
                <th class="n">Unit price</th>
                @if (showVatColumn)
                {
                    <th class="n">VAT</th>
                }
                <th class="n">Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in lines)
            {
                <tr>
                    <td class="doc-desc">
                        <span class="doc-pre">@line.Description</span>
                        @if (!rules.HasReducedRate && totals.IsTaxInvoice && line.TaxCode == TaxCode.Zero)
                        {
                            <span class="doc-tag">@rules.ZeroLabel</span>
                        }
                    </td>
                    <td class="n">@Format.Quantity(line.Quantity)</td>
                    <td class="n">@Format.Amount(line.UnitPriceCents)</td>
                    @if (showVatColumn)
                    {
                        <td class="n">@LineRate(line)</td>
                    }
                    <td class="n">@Format.Amount(MoneyMath.LineAmount(line.Quantity, line.UnitPriceCents))</td>
                </tr>
            }
            @if (lines.Count == 0)
            {
                <tr><td colspan="@columnCount" class="doc-placeholder">Line items appear here</td></tr>
            }
        </tbody>
    </table>

    <div class="doc-summary">
        <div class="doc-summary-notes">
            @if (!totals.IsTaxInvoice)
            {
                <p class="doc-small">@(InvoiceDefaults.IsOverseas(client, Profile) && Profile.OverseasNote.Length > 0 ? Profile.OverseasNote : $"No {rules.TaxWord} has been charged.")</p>
            }
            @if (!rules.HasReducedRate && hasGstFree)
            {
                <p class="doc-small">Items marked @rules.ZeroLabel have no @rules.TaxWord included.</p>
            }
            @if (quote)
            {
                <p class="doc-small">To accept this quote, reply to the email it came with.</p>
            }
        </div>
        <div class="doc-totals">
            @if (!quote && status is DisplayStatus.Paid or DisplayStatus.Void)
            {
                <div class="doc-stamp @(status == DisplayStatus.Void ? "void" : null) @(AnimateStamp ? "animate" : null)" aria-hidden="true">
                    @(status == DisplayStatus.Void ? "VOID" : "PAID")
                    @if (status == DisplayStatus.Paid && Invoice.Payments.Count > 0)
                    {
                        <small>@Format.DateLong(Invoice.Payments.Max(p => p.Date))</small>
                    }
                </div>
            }
            @if (totals.IsTaxInvoice)
            {
                <div class="doc-row"><span>Subtotal (ex @rules.TaxWord)</span><span class="n">@Format.Amount(totals.SubtotalCents)</span></div>
                @foreach (var band in bands)
                {
                    <div class="doc-row"><span>@rules.TaxName @Format.Percent(band.RatePpm)</span><span class="n">@Format.Amount(band.TaxCents)</span></div>
                }
            }
            <div class="doc-row doc-total"><span>@(totals.IsTaxInvoice ? $"Total inc. {rules.TaxWord}" : "Total")</span><span class="n">@Format.Money(totals.TotalCents)</span></div>
            @if (paid > 0)
            {
                <div class="doc-row"><span>Paid</span><span class="n">&minus;@Format.Amount(paid)</span></div>
                <div class="doc-row doc-balance"><span>Balance due</span><span class="n">@Format.Money(balance)</span></div>
            }
        </div>
    </div>

    @if (Invoice.Notes.Length > 0)
    {
        <section class="doc-notes">
            <div class="doc-label">Notes</div>
            <p class="doc-pre">@Invoice.Notes</p>
        </section>
    }

    <div class="doc-spacer"></div>

    @if (hasBank && !quote && status != DisplayStatus.Void)
    {
        <section class="doc-remit">
            <div class="doc-remit-title">How to pay</div>
            <dl class="doc-remit-grid">
                @if (Profile.BankAccountName.Length > 0)
                {
                    <div><dt>Account name</dt><dd>@Profile.BankAccountName</dd></div>
                }
                @if (rules.BankCode is { } bank && Profile.BankCode.Length > 0)
                {
                    <div><dt>@bank.Label</dt><dd class="n">@Profile.BankCode</dd></div>
                }
                <div><dt>Account number</dt><dd class="n">@Profile.AccountNumber</dd></div>
                @if (Profile.SwiftCode.Length > 0)
                {
                    <div><dt>SWIFT/BIC</dt><dd class="n">@Profile.SwiftCode</dd></div>
                }
                <div><dt>Reference</dt><dd class="n">@(Invoice.Number.Length > 0 ? Invoice.Number : NumberPreview)</dd></div>
            </dl>
        </section>
    }

    <footer class="doc-foot">
        <span>@Profile.FooterNote</span>
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public Invoice Invoice { get; set; } = default!;
    [Parameter, EditorRequired] public BusinessProfile Profile { get; set; } = default!;
    [Parameter] public string? LogoUrl { get; set; }
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public string NumberPreview { get; set; } = "";
    [Parameter] public bool AnimateStamp { get; set; }
    // lets settings show every layout side by side before one is saved
    [Parameter] public string? Template { get; set; }

    string LineRate(InvoiceLine line) => line.TaxCode switch
    {
        TaxCode.Standard => Format.Percent(Invoice.TaxRatePpm),
        TaxCode.Reduced => Format.Percent(Invoice.ReducedRatePpm),
        TaxCode.Exempt => Countries.For(Profile.Country).ExemptLabel,
        _ => "0%",
    };
}
