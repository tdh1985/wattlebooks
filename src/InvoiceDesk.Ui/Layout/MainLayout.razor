@inherits LayoutComponentBase
@implements IDisposable
@inject ProfileService Profiles
@inject ThemeService Theme
@inject ShortcutService Shortcuts
@inject NavigationManager Nav
@inject LaunchRequests Launches
@inject RecurringRunner Recurring
@inject ToastService Toasts
@inject IJSRuntime JS

<div class="shell" style="--accent: @_accent">
    <nav class="rail" aria-label="Main">
        <a class="brand" href="settings" title="Business details">
            @if (_logoUrl is not null)
            {
                <img class="brand-logo" src="@_logoUrl" alt="" />
            }
            else
            {
                <span class="brand-mark" aria-hidden="true">@Format.Initials(BusinessName)</span>
            }
            <span class="brand-name">@BusinessName</span>
        </a>

        <button type="button" class="rail-search" @onclick="OpenPalette">
            <Icon Name="search" Size="16" />
            <span>Search</span>
            <kbd>Ctrl K</kbd>
        </button>

        <a class="btn btn-primary rail-new" href="invoices/new"><Icon Name="plus" Size="16" /> New invoice</a>

        <div class="tabs">
            <NavLink class="tab" href="" Match="NavLinkMatch.All"><Icon Name="dashboard" /> Dashboard</NavLink>
            <NavLink class="tab" href="invoices"><Icon Name="invoice" /> Invoices</NavLink>
            <NavLink class="tab" href="clients"><Icon Name="users" /> Clients</NavLink>
            <NavLink class="tab" href="money"><Icon Name="wallet" /> Money in &amp; out</NavLink>
            <NavLink class="tab" href="reports"><Icon Name="chart" /> Reports</NavLink>
        </div>

        <div class="rail-foot">
            <NavLink class="tab" href="settings"><Icon Name="sliders" /> Settings</NavLink>
            <div class="theme-switch" role="group" aria-label="Theme">
                @foreach (var choice in ThemeService.Choices)
                {
                    <button type="button" class="@(Theme.Theme == choice ? "on" : null)" aria-pressed="@(Theme.Theme == choice)"
                            title="@Theme.Label(choice)" @onclick="() => SetTheme(choice)">
                        <Icon Name="@ThemeIcon(choice)" Size="15" />
                    </button>
                }
            </div>
        </div>
    </nav>

    <div class="main">
        <main class="sheet" id="sheet">
            <ErrorBoundary @ref="_boundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex"><ErrorPanel Exception="ex" OnReload="Recover" /></ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

<ToastHost />
<CommandPalette @ref="_palette" OnShowShortcuts="() => _help = true" />
<ShortcutsHelp Open="_help" OnClose="() => _help = false" />

@code {
    ErrorBoundary? _boundary;
    CommandPalette? _palette;
    DotNetObjectReference<MainLayout>? _ref;
    BusinessProfile? _profile;
    string _accent = "#2E6B57";
    string? _logoUrl;
    bool _help;

    string BusinessName => _profile?.Name is { Length: > 0 } name ? name : "Your business";

    protected override async Task OnInitializedAsync()
    {
        Profiles.Changed += OnProfileChanged;
        Theme.Changed += OnThemeChanged;
        Theme.TranslucentChanged += OnTranslucentChanged;
        Launches.Requested += OnLaunchRequested;
        Nav.LocationChanged += OnLocationChanged;
        await LoadProfileAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("invoicedesk.init", _ref);
        await JS.InvokeVoidAsync("invoicedesk.applyTheme", Theme.Theme);
        await JS.InvokeVoidAsync("invoicedesk.setMica", Theme.Translucent);
        OpenLaunchRequest();
        if (Recurring.TakeStartupCount() is > 0 and var made)
        {
            Toasts.Show(RecurringRunner.Message(made), ToastKind.Info,
                new ToastAction("See drafts", () => { Nav.NavigateTo("invoices?show=draft"); return Task.CompletedTask; }));
        }
    }

    void OpenLaunchRequest()
    {
        if (Launches.TakePending() is { } route) Nav.NavigateTo(route);
    }

    void OnLaunchRequested() => InvokeAsync(OpenLaunchRequest);

    async Task LoadProfileAsync()
    {
        _profile = await Profiles.GetAsync();
        _accent = _profile.AccentColour;
        _logoUrl = FilesUrl.Logo(_profile);
    }

    [JSInvokable]
    public void OnShortcut(string key)
    {
        switch (key)
        {
            case "k":
                _palette?.Open();
                break;
            case "n":
                Nav.NavigateTo("invoices/new");
                break;
            case "help":
                _ = InvokeAsync(() =>
                {
                    _help = true;
                    StateHasChanged();
                });
                break;
            default:
                Shortcuts.Raise(key);
                break;
        }
    }

    [JSInvokable]
    public void ThemeResolved(bool dark) => Theme.ReportResolved(dark);

    void OpenPalette() => _palette?.Open();

    void SetTheme(string choice) => Theme.Set(choice);

    void Recover() => _boundary?.Recover();

    static string ThemeIcon(string choice) => choice switch { "light" => "sun", "dark" => "moon", _ => "monitor" };

    void OnProfileChanged() => InvokeAsync(async () =>
    {
        await LoadProfileAsync();
        StateHasChanged();
    });

    void OnThemeChanged() => InvokeAsync(async () =>
    {
        await JS.InvokeVoidAsync("invoicedesk.applyTheme", Theme.Theme);
        StateHasChanged();
    });

    void OnTranslucentChanged() => InvokeAsync(() => JS.InvokeVoidAsync("invoicedesk.setMica", Theme.Translucent).AsTask());

    void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() => _boundary?.Recover());

    public void Dispose()
    {
        Profiles.Changed -= OnProfileChanged;
        Theme.Changed -= OnThemeChanged;
        Theme.TranslucentChanged -= OnTranslucentChanged;
        Launches.Requested -= OnLaunchRequested;
        Nav.LocationChanged -= OnLocationChanged;
        _ref?.Dispose();
    }
}
