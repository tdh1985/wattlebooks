@* no injected services since HtmlRenderer also renders this for pdfs *@
@{
    var rules = Countries.For(Profile.Country);
}
<article class="doc doc-report" style="--doc-accent: @Profile.AccentColour">
    <header class="doc-head">
        <div class="doc-from">
            @if (LogoUrl is not null)
            {
                <img class="doc-logo" src="@LogoUrl" alt="" />
            }
            <div class="doc-from-text">
                <div class="doc-biz">@(Profile.Name.Length > 0 ? Profile.Name : "Your business name")</div>
                @if (rules.TaxNumber.IsValid(Profile.TaxNumber))
                {
                    <div class="doc-small">@rules.TaxNumber.Label @rules.TaxNumber.Display(Profile.TaxNumber)</div>
                }
            </div>
        </div>
        <div class="doc-title">
            <h1>@(Return is not null ? Return.Title.ToUpperInvariant() : "PROFIT & LOSS")</h1>
            <div class="doc-number">@PeriodLabel</div>
        </div>
    </header>

    @if (Return is { } ret)
    {
        <section class="doc-section">
            <h2>@rules.TaxName for @PeriodLabel</h2>
            <p class="doc-small">@Format.DateLong(ret.Period.Start) to @Format.DateLong(ret.Period.End), cash basis</p>
            <table class="doc-lines">
                <tbody>
                    @foreach (var b in ret.Boxes)
                    {
                        var cents = b.Line == ReturnLine.Result ? Math.Abs(b.Cents) : b.Cents;
                        <tr class="@(b.Line switch { ReturnLine.Result => "doc-sum", ReturnLine.Total => "doc-total-row", _ => null })">
                            <td>
                                @if (b.Code.Length > 0)
                                {
                                    <span class="doc-code">@b.Code</span>
                                }
                                @b.Label
                                @if (b.Note is not null)
                                {
                                    <span class="doc-tag">@b.Note</span>
                                }
                            </td>
                            <td class="n">@(b.WholeUnits ? Format.WholeMoney(cents) : Format.Money(cents))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="doc-section">
            <h2>Where G1 comes from</h2>
            <p class="doc-small">Money received in the period by category, so you can check what belongs in total sales.</p>
            <table class="doc-lines">
                <thead><tr><th>Category</th><th class="n">@rules.TaxName</th><th class="n">Received</th></tr></thead>
                <tbody>
                    @foreach (var c in ret.SalesByCategory)
                    {
                        <tr><td>@c.Category</td><td class="n">@Format.Amount(c.TaxCents)</td><td class="n">@Format.Amount(c.AmountCents)</td></tr>
                    }
                    @if (ret.SalesByCategory.Count == 0)
                    {
                        <tr><td colspan="3" class="doc-placeholder">No money came in during this period.</td></tr>
                    }
                </tbody>
            </table>
        </section>

        <p class="doc-disclaimer">
            Worked out from payments received and expenses paid in the period. Bank interest and some other income may not belong in G1,
            so check with your accountant or @rules.TaxOffice before you lodge. This isn't tax advice.
        </p>
    }
    else if (Pl is { } pl)
    {
        <section class="doc-section">
            <h2>Income</h2>
            <p class="doc-small">@Format.DateLong(pl.Period.Start) to @Format.DateLong(pl.Period.End), cash basis, amounts exclude @rules.TaxWord</p>
            <table class="doc-lines">
                <tbody>
                    @foreach (var c in pl.Income)
                    {
                        <tr class="doc-sub"><td>@c.Category</td><td class="n">@Format.Amount(c.ExTaxCents)</td></tr>
                    }
                    <tr class="doc-sum"><td>Total income</td><td class="n">@Format.Money(pl.IncomeCents)</td></tr>
                </tbody>
            </table>
        </section>

        <section class="doc-section">
            <h2>Expenses</h2>
            <table class="doc-lines">
                <tbody>
                    @foreach (var c in pl.Expenses)
                    {
                        <tr class="doc-sub"><td>@c.Category</td><td class="n">@Format.Amount(c.ExTaxCents)</td></tr>
                    }
                    <tr class="doc-sum"><td>Total expenses</td><td class="n">@Format.Money(pl.ExpensesCents)</td></tr>
                </tbody>
            </table>
        </section>

        <section class="doc-section">
            <table class="doc-lines">
                <tbody>
                    <tr class="doc-sum"><td>@(pl.ProfitCents >= 0 ? "Net profit" : "Net loss")</td><td class="n">@Format.Money(Math.Abs(pl.ProfitCents))</td></tr>
                </tbody>
            </table>
        </section>

        <p class="doc-disclaimer">Worked out from money received and paid in the period. This isn't tax advice.</p>
    }

    <div class="doc-spacer"></div>
    <footer class="doc-foot">
        <span>Prepared with InvoiceDesk on @Format.DateLong(Today)</span>
    </footer>
</article>

@code {
    [Parameter] public TaxReturn? Return { get; set; }
    [Parameter] public ProfitAndLoss? Pl { get; set; }
    [Parameter, EditorRequired] public BusinessProfile Profile { get; set; } = default!;
    [Parameter] public string? LogoUrl { get; set; }
    [Parameter] public string PeriodLabel { get; set; } = "";
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);
}
