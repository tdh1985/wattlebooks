@* no injected services since HtmlRenderer also renders this for pdfs *@
@{
    var rules = Countries.For(Profile.Country);
    var client = Statement.Client;
    var hasBank = Profile.AccountNumber.Length > 0 || Profile.BankCode.Length > 0;
}
<article class="doc doc-statement" style="--doc-accent: @Profile.AccentColour">
    <header class="doc-head">
        <div class="doc-from">
            @if (LogoUrl is not null)
            {
                <img class="doc-logo" src="@LogoUrl" alt="" />
            }
            <div class="doc-from-text">
                <div class="doc-biz">@(Profile.Name.Length > 0 ? Profile.Name : "Your business name")</div>
                @if (rules.TaxNumber.IsValid(Profile.TaxNumber))
                {
                    <div class="doc-small">@rules.TaxNumber.Label @rules.TaxNumber.Display(Profile.TaxNumber)</div>
                }
                @if (Profile.Address.Length > 0)
                {
                    <div class="doc-small doc-pre">@Profile.Address</div>
                }
                @if (Profile.Email.Length > 0)
                {
                    <div class="doc-small">@Profile.Email</div>
                }
                @if (Profile.Phone.Length > 0)
                {
                    <div class="doc-small">@Profile.Phone</div>
                }
            </div>
        </div>
        <div class="doc-title">
            <h1>STATEMENT</h1>
            <div class="doc-number">@Format.DateLong(Statement.AsOf)</div>
        </div>
    </header>

    <section class="doc-parties">
        <div>
            <div class="doc-label">Account of</div>
            <div class="doc-client">@client.Name</div>
            @if (client.ContactName.Length > 0)
            {
                <div class="doc-small">Attention: @client.ContactName</div>
            }
            @if (client.Address.Length > 0)
            {
                <div class="doc-small doc-pre">@client.Address</div>
            }
        </div>
        <dl class="doc-dates">
            <dt>Statement date</dt>
            <dd>@Format.DateLong(Statement.AsOf)</dd>
            <dt>Invoices unpaid</dt>
            <dd>@InvoiceCount</dd>
            <dt class="doc-due">Total owing</dt>
            <dd class="doc-due">@TotalOwingText</dd>
        </dl>
    </section>

    @foreach (var section in Statement.Sections)
    {
        <section class="@(Statement.Sections.Count > 1 ? "doc-section" : null)">
            @if (Statement.Sections.Count > 1)
            {
                <h2>Owing in @section.Currency</h2>
            }
            <dl class="doc-aged">
                @foreach (var (label, cents) in Buckets(section.Aged))
                {
                    <div class="@(cents > 0 && label != "Not yet due" ? "late" : null)">
                        <dt>@label</dt>
                        <dd class="n">@Format.Money(cents, section.Currency)</dd>
                    </div>
                }
            </dl>

            <table class="doc-lines">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Issued</th>
                        <th>Due</th>
                        <th class="n">Total</th>
                        <th class="n">Paid</th>
                        <th class="n">Owing</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in section.Lines)
                    {
                        var s = line.Invoice;
                        <tr>
                            <td>
                                <span class="doc-inv">@s.Number</span>
                                @if (line.DaysOverdue > 0)
                                {
                                    <span class="doc-tag doc-late">@(line.DaysOverdue == 1 ? "1 day overdue" : $"{line.DaysOverdue} days overdue")</span>
                                }
                            </td>
                            <td>@Format.DateLong(s.IssueDate)</td>
                            <td>@Format.DateLong(s.DueDate)</td>
                            <td class="n">@Format.Amount(s.TotalCents)</td>
                            <td class="n">@(s.PaidCents > 0 ? Format.Amount(s.PaidCents) : "–")</td>
                            <td class="n">@Format.Amount(s.BalanceCents)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="doc-summary">
                <div></div>
                <div class="doc-totals">
                    <div class="doc-row doc-total"><span>Total owing</span><span class="n">@Format.Money(section.Aged.Total, section.Currency)</span></div>
                </div>
            </div>
        </section>
    }
    @if (Statement.Sections.Count == 0)
    {
        <p class="doc-placeholder">Nothing is owing. Thank you.</p>
    }

    <div class="doc-spacer"></div>

    @if (hasBank && Statement.Sections.Any(s => s.Aged.Total > 0))
    {
        <section class="doc-remit">
            <div class="doc-remit-title">How to pay</div>
            <dl class="doc-remit-grid">
                @if (Profile.BankAccountName.Length > 0)
                {
                    <div><dt>Account name</dt><dd>@Profile.BankAccountName</dd></div>
                }
                @if (rules.BankCode is { } bank && Profile.BankCode.Length > 0)
                {
                    <div><dt>@bank.Label</dt><dd class="n">@Profile.BankCode</dd></div>
                }
                <div><dt>Account number</dt><dd class="n">@Profile.AccountNumber</dd></div>
                <div><dt>Reference</dt><dd>The invoice numbers you're paying</dd></div>
            </dl>
        </section>
    }

    <footer class="doc-foot">
        <span>@Profile.FooterNote</span>
    </footer>
</article>

@code {
    [Parameter, EditorRequired] public Statement Statement { get; set; } = default!;
    [Parameter, EditorRequired] public BusinessProfile Profile { get; set; } = default!;
    [Parameter] public string? LogoUrl { get; set; }

    int InvoiceCount => Statement.Sections.Sum(s => s.Lines.Count);

    // several currencies need each one named, not summed into one wrong total
    string TotalOwingText => Statement.Sections.Count == 0
        ? Format.Money(0)
        : Format.MoneyList(Statement.Sections.Select(s => new CurrencyAmount(s.Currency, s.Aged.Total)));

    static IEnumerable<(string Label, long Cents)> Buckets(AgedTotals aged) =>
    [
        ("Not yet due", aged.Current),
        ("1–30 days", aged.Late1To30),
        ("31–60 days", aged.Late31To60),
        ("61–90 days", aged.Late61To90),
        ("Over 90 days", aged.LateOver90),
    ];
}
