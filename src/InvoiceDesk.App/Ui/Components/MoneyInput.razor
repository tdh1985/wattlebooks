<div class="affix">
    <span class="affix-text">@Format.Mark(Currency)</span>
    <input id="@Id" class="input num" inputmode="decimal" placeholder="0.00" autocomplete="off"
           aria-label="@AriaLabel" value="@_text"
           @oninput="OnInputAsync" @onchange="OnChangeAsync" @onkeydown="OnKeyDown" />
</div>

@code {
    [Parameter] public long Cents { get; set; }
    [Parameter] public EventCallback<long> CentsChanged { get; set; }
    [Parameter] public string? Id { get; set; }
    // leave it unset for home money, which is what most fields hold
    [Parameter] public string? Currency { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    string _text = "";
    long? _shown;

    protected override void OnParametersSet()
    {
        // only reformat when the value changed from outside, never mid-typing
        if (_shown == Cents) return;
        _shown = Cents;
        _text = Cents == 0 ? "" : Format.MoneyInput(Cents);
    }

    async Task OnInputAsync(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        var cents = Format.ParseMoney(_text) ?? 0;
        _shown = cents;
        await CentsChanged.InvokeAsync(cents);
    }

    Task OnChangeAsync(ChangeEventArgs e)
    {
        var cents = Format.ParseMoney(e.Value?.ToString()) ?? 0;
        _shown = cents;
        _text = cents == 0 ? "" : Format.MoneyInput(cents);
        return CentsChanged.InvokeAsync(cents);
    }
}
