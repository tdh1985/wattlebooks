<?xml version="1.0" encoding="utf-8"?>
<!-- identity values come from partner center, product 9NHXGB9BDRR1 -->
<!-- the display name must be reserved in partner center before submitting -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="TIMD.InvoiceDesk"
    Publisher="CN=A4C4B8E0-4035-4AD1-ACEB-11F2BBFD28CF"
    Version="$(Version).0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Wattlebooks</DisplayName>
    <PublisherDisplayName>TIMD</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-AU" />
  </Resources>

  <Applications>
    <Application Id="Wattlebooks" Executable="Wattlebooks.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Wattlebooks"
        Description="Free invoicing for sole traders: tax invoices, GST and your BAS figures."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Wattlebooks" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
