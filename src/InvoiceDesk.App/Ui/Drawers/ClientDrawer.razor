@inject ClientService Clients
@inject ProfileService Profiles
@inject ToastService Toasts

<Drawer Open="Open" Title="@(IsNew ? "New client" : "Edit client")" OnClose="OnClose">
    <ChildContent>
        <form id="client-form" class="col gap-16" @onsubmit="SaveAsync">
            @if (_errors is { Count: > 0 })
            {
                <div class="banner banner-error"><Icon Name="alert" Size="16" /><div>@string.Join(" ", _errors)</div></div>
            }
            <div class="field">
                <label for="client-name">Business or person's name</label>
                <input id="client-name" class="input" @bind="_client.Name" placeholder="Acme Pty Ltd" />
            </div>
            <div class="form-grid">
                <div class="field">
                    <label for="client-contact">Contact person</label>
                    <input id="client-contact" class="input" @bind="_client.ContactName" />
                </div>
                <div class="field">
                    <label for="client-tax-number">@(TaxRule?.Label ?? "Tax number")</label>
                    <input id="client-tax-number" class="input num" style="text-align:left" @bind="_client.TaxNumber" placeholder="@TaxRule?.Placeholder" />
                    <span class="hint @(TaxNumberBad ? "field-error" : null)">@TaxNumberHint</span>
                </div>
                <div class="field">
                    <label for="client-email">Email</label>
                    <input id="client-email" type="email" class="input" @bind="_client.Email" />
                </div>
                <div class="field">
                    <label for="client-phone">Phone</label>
                    <input id="client-phone" type="tel" class="input" @bind="_client.Phone" />
                </div>
                <div class="field span-2">
                    <label for="client-website">Website</label>
                    <input id="client-website" class="input" placeholder="Optional" @bind="_client.Website" />
                </div>
                <div class="field span-2">
                    <label for="client-address">Address</label>
                    <textarea id="client-address" class="textarea" rows="3" @bind="_client.Address"></textarea>
                    <span class="hint">Printed under "Bill to" on invoices.</span>
                </div>
                <div class="field">
                    <label for="client-country">Country</label>
                    <select id="client-country" class="select" value="@_client.Country" @onchange="OnCountryChanged">
                        <option value="">@Format.Country.Name (same as you)</option>
                        @foreach (var c in Countries.All.Where(c => c.Code != Format.Country.Code))
                        {
                            <option value="@c.Code">@c.Name</option>
                        }
                        <option disabled>──────────</option>
                        @foreach (var c in WorldCountries.All.Where(c => !Countries.IsSupported(c.Code)))
                        {
                            <option value="@c.Code">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="client-currency">Currency</label>
                    <select id="client-currency" class="select" @bind="_client.Currency">
                        <option value="">Your currency (@Format.Country.Currency)</option>
                        @foreach (var c in Currencies.All.Where(c => c.Code != Format.Country.Currency))
                        {
                            <option value="@c.Code">@Currencies.Label(c.Code)</option>
                        }
                    </select>
                    <span class="hint">New invoices for this client start in this currency.</span>
                </div>
                @if (_profile is not null && Format.Country.Provinces.Count > 0 && !InvoiceDefaults.IsOverseas(_client, _profile!))
                {
                    <div class="field">
                        <label for="client-province">Province or territory</label>
                        <select id="client-province" class="select" @bind="_client.Region">
                            <option value="">Same as you</option>
                            @foreach (var p in Format.Country.Provinces)
                            {
                                <option value="@p.Code">@p.Name (@p.TaxName @Format.Percent(p.RatePpm))</option>
                            }
                        </select>
                    </div>
                }
                <div class="field span-2">
                    <label for="client-invoice-note">Note on their invoices</label>
                    <textarea id="client-invoice-note" class="textarea" rows="2" placeholder="For example: PO 4471, or Attention: Accounts Payable" @bind="_client.InvoiceNote"></textarea>
                    <span class="hint">Printed on every invoice to this client.</span>
                </div>
                <div class="field span-2">
                    <label for="client-notes">Private notes</label>
                    <textarea id="client-notes" class="textarea" rows="2" @bind="_client.Notes"></textarea>
                    <span class="hint">Only you see these.</span>
                </div>
            </div>
        </form>
    </ChildContent>
    <Footer>
        <button type="submit" form="client-form" class="btn btn-primary">@(IsNew ? "Add client" : "Save client")</button>
        <button type="button" class="btn btn-ghost" @onclick="OnClose">Cancel</button>
    </Footer>
</Drawer>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public Client? Client { get; set; }
    [Parameter] public EventCallback<Client> OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    Client _client = new();
    BusinessProfile? _profile;
    IReadOnlyList<string>? _errors;
    bool _wasOpen;

    bool IsNew => _client.Id == 0;

    // null before the profile loads, or for a country we don't know
    TaxNumberRule? TaxRule => _profile is null ? null : InvoiceDefaults.TaxNumberRuleFor(_client, _profile);

    bool TaxNumberBad => TaxRule is not null && _client.TaxNumber.Length > 0 && !TaxRule.IsValid(_client.TaxNumber);

    string TaxNumberHint => TaxRule is null
        ? "Printed on your invoices to them."
        : TaxNumberBad ? TaxRule.BadHint : TaxRule.EmptyHint;

    protected override async Task OnParametersSetAsync()
    {
        // copy on open so cancelling leaves the caller's client untouched
        if (Open && !_wasOpen)
        {
            _client = Client?.Clone() ?? new Client();
            _errors = null;
            _profile = await Profiles.GetAsync();
        }
        _wasOpen = Open;
    }

    // a client abroad usually pays in their own money, so suggest it once
    void OnCountryChanged(ChangeEventArgs e)
    {
        _client.Country = e.Value?.ToString() ?? "";
        if (_client.Currency.Length == 0 && WorldCountries.CurrencyOf(_client.Country) is { } cur
            && Currencies.IsSupported(cur) && cur != Format.Country.Currency)
            _client.Currency = cur;
        if (InvoiceDefaults.IsOverseas(_client, _profile!)) _client.Region = "";
    }

    async Task SaveAsync()
    {
        try
        {
            var isNew = IsNew;
            var saved = await Clients.SaveAsync(_client);
            Toasts.Show(isNew ? $"{saved.Name} added" : "Client saved");
            await OnSaved.InvokeAsync(saved);
        }
        catch (ValidationException ex)
        {
            _errors = ex.Errors;
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
    }
}
