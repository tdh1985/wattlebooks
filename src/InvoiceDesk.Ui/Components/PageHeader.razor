<header class="page-head">
    <div class="page-title">
        @if (Back is not null)
        {
            <a class="back-link" href="@Back"><Icon Name="chevron-left" Size="16" /> @BackLabel</a>
        }
        <h1 tabindex="-1">@Title</h1>
        @if (Subtitle is not null)
        {
            <p class="page-sub">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Back { get; set; }
    [Parameter] public string BackLabel { get; set; } = "Back";
}
