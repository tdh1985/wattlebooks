@implements IDisposable
@inject ShortcutService Shortcuts
@inject IJSRuntime JS

@if (Open)
{
    <div class="scrim" @onclick="CloseAsync"></div>
    <aside class="drawer @(Wide ? "wide" : null)" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
        <header class="drawer-head">
            <h2 id="drawer-title">@Title</h2>
            <button type="button" class="btn btn-ghost btn-icon" aria-label="Close" @onclick="CloseAsync"><Icon Name="x" /></button>
        </header>
        <div class="drawer-body">@ChildContent</div>
        @if (Footer is not null)
        {
            <footer class="drawer-foot">@Footer</footer>
        }
    </aside>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Wide { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    bool _focused;

    IDisposable? _overlay;

    // esc goes to whichever overlay opened last
    protected override void OnParametersSet()
    {
        if (Open) _overlay ??= Shortcuts.AddOverlay(() => _ = InvokeAsync(CloseAsync));
        else ReleaseOverlay();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_focused)
        {
            _focused = true;
            await JS.InvokeVoidAsync("invoicedesk.focus", ".drawer-body input:not([type=file]):not([type=checkbox]), .drawer-body textarea, .drawer-body select");
        }
        if (!Open) _focused = false;
    }

    Task CloseAsync() => OnClose.InvokeAsync();

    void ReleaseOverlay()
    {
        _overlay?.Dispose();
        _overlay = null;
    }

    public void Dispose() => ReleaseOverlay();
}
